# ─────────────────────────────────────────────────────────────
# Tuiton — Development Environment
# ⚠️  DO NOT commit this file to git
# Copy to .env for local development
# ─────────────────────────────────────────────────────────────

# Database
DATABASE_URL="file:./dev.db"

# Auth secret (development only - generate a secure one for production)
AUTH_SECRET="dev-secret-change-in-production-min-32-chars"

# Public app config
NEXT_PUBLIC_APP_NAME="Tuiton"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (empty for dev - will use email/password only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# SMS Provider (empty for dev - OTP mocked)
MSG91_AUTH_KEY=""