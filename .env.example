# ─────────────────────────────────────────────────────────────
# Tuiton — root env template. Copy into the workspace env files:
#   apps/web/.env.local   (Next.js runtime secrets)
#   packages/db/.env      (Prisma DATABASE_URL)
# A working dev set is generated for you in those two files.
# ─────────────────────────────────────────────────────────────

# SQLite for dev; switch to a Postgres URL for production:
#   "postgresql://user:pass@localhost:5432/tuiton"
DATABASE_URL="file:./dev.db"

# 32+ chars — used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-change-me-please-generate-a-real-one-32chars"

# Public (exposed to the browser)
NEXT_PUBLIC_APP_NAME="Tuiton"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# External auth (Phase 1 stubs these — leave blank for dev):
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# SMS/OTP provider (leave blank in dev — OTP is mocked server-side):
MSG91_AUTH_KEY=""
